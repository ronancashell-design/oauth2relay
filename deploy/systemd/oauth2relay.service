# systemd unit for OAUTH2Relay. Install it with:
#
#   install -m 0755 oauth2relay /usr/local/bin/oauth2relay
#   useradd --system --no-create-home --shell /usr/sbin/nologin oauth2relay
#   install -d -m 0750 -g oauth2relay /etc/oauth2relay
#   install -m 0640 -g oauth2relay config.json /etc/oauth2relay/config.json
#     (start from examples/config.example.json, included in the release archives)
#   install -m 0644 oauth2relay.service /etc/systemd/system/oauth2relay.service
#   systemctl daemon-reload
#   systemctl enable --now oauth2relay
#
# Logs go to the journal: journalctl -u oauth2relay. See docs/OPERATIONS.md.

[Unit]
Description=OAUTH2Relay OAuth 2.0 authentication relay
Documentation=https://oauth2relay.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=oauth2relay
Group=oauth2relay
# Environment variables: credentials referenced as ${env:NAME} in the
# configuration, and secrets manager settings such as AWS_REGION,
# VAULT_ADDR or AZURE_CLIENT_SECRET, and for client_secret_env. Keep this
# file mode 0600, owned by root.
EnvironmentFile=-/etc/oauth2relay/oauth2relay.env
ExecStartPre=/usr/local/bin/oauth2relay --check-config --config /etc/oauth2relay/config.json
ExecStart=/usr/local/bin/oauth2relay --config /etc/oauth2relay/config.json
Restart=on-failure
RestartSec=5s
# Must exceed server.shutdown_delay + server.shutdown_timeout (15 by default).
TimeoutStopSec=45s

# Writable /var/log/oauth2relay, for the optional "logfile" setting.
LogsDirectory=oauth2relay
LogsDirectoryMode=0750
UMask=0077

CapabilityBoundingSet=
# To listen on a port below 1024, uncomment:
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
